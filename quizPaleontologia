<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz Pré-Histórico | Expedição Paleontológica</title>
    <!-- Carregando Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Carregando Fontes Google (Cinzel para títulos temáticos e Inter para leitura limpa) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Cinzel', 'serif'],
                    },
                    colors: {
                        jungle: {
                            950: '#0a120d',
                            900: '#132219',
                            800: '#1c3325',
                            700: '#274734',
                        },
                        amber: {
                            450: '#f59e0b',
                            550: '#d97706',
                        },
                        parchment: '#f4efe6',
                    },
                    animation: {
                        'fade-in': 'fadeIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'avatar-float': 'avatarFloat 2.8s ease-in-out infinite',
                        'avatar-chomp': 'avatarChomp 1.8s ease-in-out infinite',
                        'avatar-glow': 'avatarGlow 2.4s ease-in-out infinite',
                    },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0', transform: 'translateY(14px) scale(0.98)' },
                            '100%': { opacity: '1', transform: 'translateY(0) scale(1)' },
                        },
                        avatarFloat: {
                            '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
                            '50%': { transform: 'translateY(-4px) rotate(4deg)' },
                        },
                        avatarChomp: {
                            '0%, 100%': { transform: 'scale(1) rotate(0deg)' },
                            '25%': { transform: 'scale(1.16) rotate(-8deg)' },
                            '50%': { transform: 'scale(1.05) rotate(6deg)' },
                        },
                        avatarGlow: {
                            '0%, 100%': { transform: 'scale(1)', filter: 'drop-shadow(0 0 2px rgba(251,191,36,0.4))' },
                            '50%': { transform: 'scale(1.12)', filter: 'drop-shadow(0 0 10px rgba(251,191,36,0.95))' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Cosméticos e Molduras Animadas */
        @keyframes shimmerBorder {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .cosmetic-amber-aura {
            box-shadow: 0 0 18px rgba(245, 158, 11, 0.45), inset 0 0 12px rgba(245, 158, 11, 0.25);
            border-color: #fbbf24 !important;
        }
        .cosmetic-emerald-pulse {
            box-shadow: 0 0 20px rgba(16, 185, 129, 0.5), inset 0 0 12px rgba(16, 185, 129, 0.25);
            border-color: #34d399 !important;
        }
        .cosmetic-magma-ring {
            background: linear-gradient(120deg, rgba(249,115,22,0.28), rgba(220,38,38,0.28), rgba(245,158,11,0.35));
            background-size: 200% 200%;
            animation: shimmerBorder 3s ease infinite;
            box-shadow: 0 0 22px rgba(249, 115, 22, 0.55);
            border-color: #fb923c !important;
        }
        .cosmetic-card-royal {
            box-shadow: 0 20px 50px -12px rgba(245, 158, 11, 0.28) !important;
            border-color: rgba(251, 191, 36, 0.65) !important;
        }
        .cosmetic-card-bio {
            box-shadow: 0 20px 50px -12px rgba(16, 185, 129, 0.3) !important;
            border-color: rgba(52, 211, 153, 0.65) !important;
        }
    </style>
</head>
<body class="bg-jungle-950 text-parchment min-h-screen flex flex-col justify-between selection:bg-amber-500 selection:text-jungle-950 relative overflow-x-hidden">

    <!-- Elementos Decorativos de Fundo (Ambiente Jurássico) -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <!-- Luz ambiente âmbar e verde floresta -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-emerald-800/20 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 -right-24 w-80 h-80 bg-amber-600/15 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-24 left-1/3 w-96 h-96 bg-stone-800/30 rounded-full blur-3xl"></div>
        
        <!-- Marca d'água SVG de Pegada de Dinossauro -->
        <svg class="absolute bottom-6 right-6 w-48 h-48 text-emerald-500/5 transform -rotate-12" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C11.2 2 10.5 3.5 10.2 6.2C9.9 8.8 10.5 11 11.2 11.5C10.1 12.1 9.5 13.5 9.8 15.2C10.2 17.5 11.5 19 12 19C12.5 19 13.8 17.5 14.2 15.2C14.5 13.5 13.9 12.1 12.8 11.5C13.5 11 14.1 8.8 13.8 6.2C13.5 3.5 12.8 2 12 2ZM6.5 6.5C5.7 6.8 5.5 8.5 6.2 10.8C6.9 13 8.1 14.5 8.9 14.2C9.7 13.9 9.8 12.2 9.1 9.9C8.4 7.7 7.3 6.2 6.5 6.5ZM17.5 6.5C16.7 6.2 15.6 7.7 14.9 9.9C14.2 12.2 14.3 13.9 15.1 14.2C15.9 14.5 17.1 13 17.8 10.8C18.5 8.5 18.3 6.8 17.5 6.5Z"/>
        </svg>
    </div>

    <!-- Cabeçalho Superior -->
    <header class="relative z-10 w-full max-w-3xl mx-auto px-4 pt-6 pb-2 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <!-- Ícone Fóssil Amonite em SVG ou Avatar Equipado -->
            <div id="header-avatar-box" class="w-11 h-11 rounded-xl bg-amber-500/15 border border-amber-500/40 flex items-center justify-center text-amber-400 shadow-inner text-2xl transition-all">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2z"/>
                    <path d="M12 12c0-2.8 2.2-5 5-5s5 2.2 5 5-2.2 5-5 5c-4.4 0-8-3.6-8-8 0-5.5 4.5-10 10-10"/>
                    <path d="M19 2c2.2 2.2 3 5.5 3 10 0 6.1-4.9 11-11 11-5.5 0-9-4.5-9-9"/>
                </svg>
            </div>
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span id="header-subtitle" class="text-xs uppercase tracking-widest text-amber-400/80 font-semibold">Expedição Jurássica</span>
                    <span id="header-equipped-title" class="hidden px-2 py-0.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-[10px] font-bold uppercase tracking-wider">
                        Título
                    </span>
                </div>
                <h1 class="font-display font-bold text-lg sm:text-xl text-parchment tracking-wide">Quiz Pré-Histórico</h1>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <!-- Saldo de Pontos (Âmbar) -->
            <div class="flex items-center gap-1.5 bg-jungle-900/90 border border-amber-500/40 px-3.5 py-1.5 rounded-full shadow-md" title="Seus pontos acumulados">
                <span class="text-sm">🟠</span>
                <span id="wallet-points-display" class="font-mono text-sm font-bold text-amber-300">0</span>
                <span class="text-[11px] uppercase tracking-wider text-amber-400/80 font-semibold hidden sm:inline">pts</span>
            </div>

            <!-- Botão da Aba de Loja -->
            <button id="btn-toggle-shop" type="button" class="flex items-center gap-1.5 bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/40 text-amber-300 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-bold transition cursor-pointer shadow-md">
                <span>🛒</span>
                <span>Loja</span>
            </button>

            <!-- Cronômetro em Tempo Real (Oculto na tela inicial) -->
            <div id="timer-badge" class="hidden items-center gap-2 bg-jungle-900/90 border border-emerald-700/40 px-3.5 py-1.5 rounded-full shadow-md">
                <svg class="w-4 h-4 text-amber-400 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span id="timer-display" class="font-mono text-sm font-semibold text-amber-300">00:00</span>
            </div>
        </div>
    </header>

    <!-- Painel de Perfil Fixo no Canto Esquerdo (Desktop) / Compacto no Topo (Mobile) -->
    <aside id="left-profile-sidebar" class="relative lg:fixed lg:left-4 lg:top-24 z-20 w-full max-w-2xl lg:w-64 mx-auto px-4 lg:px-0 mt-2 lg:mt-0">
        <div id="profile-sidebar-card" class="bg-jungle-900/90 backdrop-blur-md border border-emerald-800/60 rounded-2xl p-4 shadow-xl transition-all">
            <div class="flex items-center justify-between gap-2 pb-3 mb-3 border-b border-emerald-800/50">
                <span class="text-[11px] uppercase tracking-widest text-amber-400 font-bold">Perfil do Explorador</span>
                <button id="btn-edit-profile-sidebar" type="button" class="text-xs bg-amber-500/15 hover:bg-amber-500/25 border border-amber-400/40 text-amber-300 px-2.5 py-1 rounded-lg font-semibold transition cursor-pointer">
                    Alterar Perfil
                </button>
            </div>

            <!-- Avatar, Nome e Título -->
            <div class="flex items-center gap-3 mb-3.5">
                <div id="sidebar-avatar-box" class="w-12 h-12 rounded-xl bg-amber-500/15 border border-amber-500/40 flex items-center justify-center text-2xl flex-shrink-0 transition-all">
                    🐚
                </div>
                <div class="min-w-0 flex-grow">
                    <label for="player-name-input" class="sr-only">Nome do Explorador</label>
                    <input
                        type="text"
                        id="player-name-input"
                        maxlength="22"
                        placeholder="Seu nome..."
                        class="w-full bg-jungle-950/80 border border-emerald-800/70 focus:border-amber-400 rounded-lg px-2.5 py-1 text-sm font-bold text-parchment placeholder-stone-500 outline-none transition"
                    />
                    <span id="sidebar-equipped-title" class="inline-block mt-1 px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-[10px] font-bold uppercase tracking-wider truncate max-w-full">
                        Aprendiz de Campo
                    </span>
                </div>
            </div>

            <!-- Visualização de Ossos Acumulados -->
            <div class="bg-jungle-950/90 border border-amber-500/30 rounded-xl px-3 py-2 flex items-center justify-between">
                <span class="text-xs text-stone-400 font-medium">Seus Ossos:</span>
                <div class="flex items-center gap-1.5">
                    <span class="text-base">🦴</span>
                    <span id="sidebar-bones-display" class="font-mono text-sm font-black text-amber-300">0</span>
                    <span class="text-[11px] uppercase tracking-wider text-amber-400/80 font-bold">ossos</span>
                </div>
            </div>
        </div>
    </aside>

    <!-- Área Principal Centralizada -->
    <main class="relative z-10 flex-grow flex items-center justify-center px-4 py-6">
        <div class="w-full max-w-2xl">
            
            <!-- ========================================== -->
            <!-- TELA 0: TELA INICIAL                       -->
            <!-- ========================================== -->
            <section id="screen-start" class="bg-jungle-900/80 backdrop-blur-md border border-emerald-800/50 rounded-3xl p-6 sm:p-10 shadow-2xl text-center animate-fade-in">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold tracking-wider uppercase mb-5">
                    <span>🦖</span> Era Mesozoica & Era do Gelo
                </div>

                <h2 class="font-display text-3xl sm:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-200 via-amber-400 to-orange-400 mb-3 leading-tight">
                    QUIZ PRÉ-HISTÓRICO
                </h2>

                <p class="text-stone-300 text-sm sm:text-base max-w-lg mx-auto mb-7 leading-relaxed">
                    Vamos ver se você realmente entende de dinossauros e criaturas pré-históricas! Escolha o nível da sua expedição e responda no menor tempo possível.
                </p>

                <!-- Seleção de Níveis de Dificuldade -->
                <div class="mb-8 text-left">
                    <span class="block text-xs uppercase tracking-widest text-amber-400/90 font-bold mb-3 text-center">
                        Selecione o Nível da Expedição
                    </span>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5" id="difficulty-cards">
                        <!-- Nível 1: Explorador -->
                        <button type="button" data-difficulty="facil" class="difficulty-card group relative bg-jungle-950/80 border-2 border-amber-400 rounded-2xl p-4 text-left transition-all cursor-pointer shadow-lg shadow-amber-500/10">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-2xl">🌿</span>
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                    5 Perguntas
                                </span>
                            </div>
                            <h3 class="font-bold text-base text-parchment group-hover:text-amber-300 transition">Explorador</h3>
                            <span class="text-[11px] uppercase tracking-wider text-emerald-400 font-semibold block mb-1.5">Nível Fácil</span>
                            <p class="text-xs text-stone-400 leading-relaxed">Espécies icônicas e gigantes famosos da pré-história.</p>
                        </button>

                        <!-- Nível 2: Paleontólogo -->
                        <button type="button" data-difficulty="medio" class="difficulty-card group relative bg-jungle-950/60 border-2 border-emerald-800/50 hover:border-emerald-600/80 rounded-2xl p-4 text-left transition-all cursor-pointer">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-2xl">🦴</span>
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30">
                                    8 Perguntas
                                </span>
                            </div>
                            <h3 class="font-bold text-base text-parchment group-hover:text-amber-300 transition">Paleontólogo</h3>
                            <span class="text-[11px] uppercase tracking-wider text-amber-400 font-semibold block mb-1.5">Nível Médio</span>
                            <p class="text-xs text-stone-400 leading-relaxed">Períodos geológicos, anatomia e fauna variada.</p>
                        </button>

                        <!-- Nível 3: Mestre Jurássico -->
                        <button type="button" data-difficulty="dificil" class="difficulty-card group relative bg-jungle-950/60 border-2 border-emerald-800/50 hover:border-emerald-600/80 rounded-2xl p-4 text-left transition-all cursor-pointer">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-2xl">🌋</span>
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-orange-500/20 text-orange-300 border border-orange-500/30">
                                    12 Perguntas
                                </span>
                            </div>
                            <h3 class="font-bold text-base text-parchment group-hover:text-amber-300 transition">Mestre Jurássico</h3>
                            <span class="text-[11px] uppercase tracking-wider text-orange-400 font-semibold block mb-1.5">Nível Difícil</span>
                            <p class="text-xs text-stone-400 leading-relaxed">Desafio completo com espécies raras e eras antigas.</p>
                        </button>
                    </div>
                </div>

                <button id="btn-start" type="button" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-jungle-950 font-bold text-lg px-8 py-4 rounded-2xl shadow-lg shadow-amber-600/20 transform transition active:scale-95 cursor-pointer">
                    <span id="btn-start-text">Iniciar Expedição (5 Perguntas)</span>
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                </button>
            </section>

            <!-- ========================================== -->
            <!-- TELAS DE PERGUNTAS DO QUIZ                 -->
            <!-- ========================================== -->
            <!-- TELAS 1 A 5: PERGUNTAS DO QUIZ             -->
            <!-- ========================================== -->
            <section id="screen-quiz" class="hidden bg-jungle-900/85 backdrop-blur-md border border-emerald-800/50 rounded-3xl p-6 sm:p-10 shadow-2xl">
                <!-- Barra de Progresso e Indicador de Pergunta -->
                <div class="mb-6">
                    <div class="flex justify-between items-center text-xs sm:text-sm font-semibold text-stone-400 mb-2">
                        <span id="question-counter" class="text-amber-400 uppercase tracking-wider">Pergunta 1 de 5</span>
                        <span id="score-live">Acertos: 0</span>
                    </div>
                    <div class="w-full h-2.5 bg-jungle-950 rounded-full overflow-hidden border border-emerald-900/50">
                        <div id="progress-bar" class="h-full bg-gradient-to-r from-emerald-500 to-amber-400 rounded-full transition-all duration-500" style="width: 20%"></div>
                    </div>
                </div>

                <!-- Emblema Visual Temático de Expedição & Geologia (Neutro, sem entregar a resposta) -->
                <div class="relative overflow-hidden bg-gradient-to-br from-jungle-950/90 via-emerald-950/50 to-jungle-950/90 border border-emerald-700/40 rounded-2xl p-4 sm:p-5 mb-6 flex items-center gap-4 shadow-inner">
                    <!-- Padrão sutil de grade topográfica no fundo -->
                    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#fbbf24 1px, transparent 1px); background-size: 16px 16px;"></div>

                    <!-- Moldura do Desenho SVG -->
                    <div id="question-emblem-container" class="relative z-10 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-amber-500/10 border border-amber-400/30 flex items-center justify-center text-amber-400 flex-shrink-0 shadow-lg shadow-amber-950/40 transition-transform duration-500">
                        <!-- SVG injetado dinamicamente pelo JavaScript -->
                    </div>

                    <!-- Metadados de Campo e Período -->
                    <div class="relative z-10 flex-grow min-w-0">
                        <div class="flex flex-wrap items-center gap-2 mb-1.5">
                            <span id="field-log-tag" class="text-[11px] font-mono uppercase tracking-widest text-amber-400/90 bg-amber-500/10 border border-amber-500/20 px-2 py-0.5 rounded-md">
                                Registro de Campo #01
                            </span>
                            <span id="question-era" class="inline-flex items-center px-2.5 py-0.5 rounded-md bg-emerald-950/90 border border-emerald-700/40 text-emerald-300 text-xs font-medium truncate">
                                Período Cretáceo
                            </span>
                        </div>
                        <p id="emblem-caption" class="text-xs sm:text-sm text-stone-400 italic truncate">
                            Análise de estratos e vestígios fósseis da expedição.
                        </p>
                    </div>
                </div>

                <!-- Enunciado da Pergunta -->
                <h2 id="question-text" class="text-xl sm:text-2xl font-bold text-parchment leading-snug mb-3">
                    1- Qual dinossauro carnívoro tinha o nome que significa "Lagarto Tirano Rei"?
                </h2>

                <!-- Balão de Dica Sutil / Piada Paleontológica -->
                <div class="bg-amber-500/10 border border-amber-500/25 rounded-xl px-4 py-2.5 mb-6 flex items-start gap-2.5">
                    <span class="text-base leading-none mt-0.5">💡</span>
                    <p id="question-hint" class="text-xs sm:text-sm text-amber-200/90 italic leading-relaxed">
                        Nota do diário: Ele definitivamente não era bom em bater palmas ou fazer flexões.
                    </p>
                </div>

                <!-- Formulário de Resposta (Equivalente ao input() do Python) -->
                <form id="answer-form" class="space-y-4" autocomplete="off">
                    <div>
                        <label for="answer-input" class="block text-xs uppercase tracking-wider text-stone-400 font-semibold mb-2">
                            Sua resposta:
                        </label>
                        <input 
                            type="text" 
                            id="answer-input" 
                            placeholder="Digite o nome do animal aqui..." 
                            class="w-full bg-jungle-950/90 border-2 border-emerald-800/70 focus:border-amber-400 rounded-2xl px-4 py-3.5 text-parchment placeholder-stone-500 text-base sm:text-lg outline-none transition shadow-inner"
                            required
                        />
                    </div>

                    <!-- Aviso de campo vazio (substitui alert) -->
                    <p id="validation-msg" class="hidden text-sm text-amber-400 font-medium">
                        ⚠️ Por favor, digite uma resposta antes de confirmar.
                    </p>

                    <!-- Botão de Enviar Resposta -->
                    <button id="btn-submit" type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-base sm:text-lg py-3.5 px-6 rounded-2xl shadow-lg shadow-emerald-900/50 transition transform active:scale-98 cursor-pointer flex items-center justify-center gap-2">
                        <span>Confirmar Resposta</span>
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </button>
                </form>

                <!-- Área de Feedback Imediato (Equivalente ao print('Parabéns...') / print('Errou...')) -->
                <div id="feedback-box" class="hidden mt-6 rounded-2xl p-5 border transition-all animate-fade-in">
                    <div class="flex items-start gap-3.5">
                        <div id="feedback-icon" class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 text-xl font-bold">
                            <!-- Ícone dinâmico -->
                        </div>
                        <div class="flex-grow">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <h3 id="feedback-title" class="font-bold text-lg">
                                    Parabéns, acertou!
                                </h3>
                                <span id="feedback-points-badge" class="hidden px-2.5 py-1 rounded-lg bg-amber-500/20 border border-amber-400/40 text-amber-300 text-xs font-bold">
                                    +100 pts (+50 bônus velocidade)
                                </span>
                            </div>
                            <p id="feedback-detail" class="text-sm mt-1 opacity-90">
                                Curiosidade paleontológica aqui.
                            </p>
                        </div>
                    </div>

                    <!-- Botão para avançar para a próxima tela -->
                    <button id="btn-next" type="button" class="mt-4 w-full bg-parchment hover:bg-white text-jungle-950 font-bold text-base py-3 px-6 rounded-xl shadow-md transition transform active:scale-98 cursor-pointer flex items-center justify-center gap-2">
                        <span id="btn-next-text">Próxima Pergunta</span>
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </button>
                </div>
