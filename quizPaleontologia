            const secondsTaken = responseTimeMs / 1000;
            let speedBonus = 0;

            if (secondsTaken <= 4) {
                speedBonus = 60;
            } else if (secondsTaken <= 8) {
                speedBonus = 40;
            } else if (secondsTaken <= 14) {
                speedBonus = 20;
            } else if (secondsTaken <= 20) {
                speedBonus = 10;
            }

            return {
                basePoints,
                speedBonus,
                total: basePoints + speedBonus,
                secondsTaken: secondsTaken.toFixed(1)
            };
        }

        /**
         * Verifica a resposta digitada pelo usuário
         */
        function handleAnswerSubmit(event) {
            event.preventDefault();
            if (isAnswered) return;

            const rawInput = answerInput.value;
            const normalizedInput = normalizeText(rawInput);

            if (!normalizedInput) {
                validationMsg.classList.remove('hidden');
                answerInput.focus();
                return;
            }

            validationMsg.classList.add('hidden');
            isAnswered = true;
            answerInput.disabled = true;
            btnSubmit.classList.add('hidden');

            const responseTimeMs = questionStartTime ? (Date.now() - questionStartTime) : 15000;
            const currentData = activeQuestions[currentQuestionIndex];
            const isCorrect = currentData.acceptedAnswers.includes(normalizedInput);

            feedbackBox.classList.remove('hidden', 'bg-emerald-950/90', 'border-emerald-500/60', 'bg-red-950/90', 'border-red-500/60');
            feedbackIcon.classList.remove('bg-emerald-500/20', 'text-emerald-400', 'bg-red-500/20', 'text-red-400');

            if (isCorrect) {
                pontos = pontos + 1;
                const scoreResult = calculateQuestionScore(responseTimeMs);
                quizEarnedPoints += scoreResult.total;
                quizSpeedBonusPoints += scoreResult.speedBonus;

                // Adiciona aos ossos acumulados do jogador e salva
                playerProfile.totalPoints += scoreResult.total;
                savePlayerProfile();
                updateProfileUI();

                scoreLive.textContent = `Acertos: ${pontos} • +${quizEarnedPoints} 🦴`;

                feedbackBox.classList.add('bg-emerald-950/90', 'border-emerald-500/60');
                feedbackIcon.classList.add('bg-emerald-500/20', 'text-emerald-400');
                feedbackIcon.textContent = "✓";
                feedbackTitle.textContent = "Parabéns, acertou!";
                feedbackTitle.className = "font-bold text-lg text-emerald-300";

                feedbackPointsBadge.classList.remove('hidden');
                feedbackPointsBadge.textContent = scoreResult.speedBonus > 0
                    ? `+${scoreResult.basePoints} 🦴 • ⚡ +${scoreResult.speedBonus} vel. (${scoreResult.secondsTaken}s)`
                    : `+${scoreResult.basePoints} 🦴 (${scoreResult.secondsTaken}s)`;

                feedbackDetail.textContent = currentData.fact;
            } else {
                feedbackBox.classList.add('bg-red-950/90', 'border-red-500/60');
                feedbackIcon.classList.add('bg-red-500/20', 'text-red-400');
                feedbackIcon.textContent = "✕";
                feedbackTitle.textContent = `Errou, a resposta era ${currentData.displayAnswer}.`;
                feedbackTitle.className = "font-bold text-lg text-red-300";
                feedbackPointsBadge.classList.add('hidden');
                feedbackDetail.textContent = currentData.fact;
            }

            setTimeout(() => btnNext.focus(), 50);
        }

        /**
         * Avança para a próxima pergunta ou finaliza o quiz
         */
        function handleNextStep() {
            currentQuestionIndex++;
            if (currentQuestionIndex < activeQuestions.length) {
                renderQuestion();
            } else {
                showFinalResults();
            }
        }

        /**
         * Exibe a Tela Final com a quantidade de acertos, pontos ganhos e tempo total
         */
        function showFinalResults() {
            const totalElapsedMs = stopTimer();
            const totalQuestions = activeQuestions.length;
            const accuracyPercent = Math.round((pontos / totalQuestions) * 100);
            const levelData = quizLevels[selectedDifficulty];

            screenQuiz.classList.add('hidden');
            screenResult.classList.remove('hidden');
            screenResult.classList.add('animate-fade-in');

            resultDifficultyBadge.textContent = `${levelData.name} • ${totalQuestions} Perguntas`;
            finalScoreText.innerHTML = `Você acertou <span class="text-amber-400 font-bold">${pontos}</span> de ${totalQuestions} perguntas.`;
            statCorrect.textContent = pontos;
            statTotal.textContent = ` / ${totalQuestions}`;
            statAccuracy.textContent = `${accuracyPercent}% de precisão`;
            statPointsEarned.textContent = `+${quizEarnedPoints} 🦴`;
            statSpeedBonus.textContent = `+${quizSpeedBonusPoints} bônus velocidade`;
            statTime.textContent = formatElapsedTime(totalElapsedMs, true);

            // Define classificação paleontológica proporcional ao percentual de acertos
            if (accuracyPercent === 100) {
                rankTitle.textContent = `Lenda do ${levelData.shortName} 🦖`;
                rankDesc.textContent = "Pontuação perfeita! Você domina completamente os segredos desta expedição!";
            } else if (accuracyPercent >= 70) {
                rankTitle.textContent = "Paleontólogo Sênior 🦴";
                rankDesc.textContent = "Excelente escavação! Seu conhecimento sobre a pré-história impressiona.";
            } else if (accuracyPercent >= 40) {
                rankTitle.textContent = "Pesquisador de Campo 🧭";
                rankDesc.textContent = "Bom trabalho! Algumas espécies ainda estão escondidas sob as camadas de rocha.";
            } else {
                rankTitle.textContent = "Turista no Parque Jurássico 🌋";
                rankDesc.textContent = "Cuidado com os predadores! Tente novamente para aprimorar suas descobertas.";
            }
        }

        /**
         * Atualiza o cabeçalho e o painel lateral esquerdo com nome, saldo de ossos, foto animada, cosmético e título
         */
        function updateProfileUI() {
            // Sincroniza unidade de ossos no cabeçalho
            const headerPointsUnit = walletPointsDisplay.nextElementSibling;
            const headerPointsEmoji = walletPointsDisplay.previousElementSibling;
            if (headerPointsEmoji) headerPointsEmoji.textContent = '🦴';
            if (headerPointsUnit) headerPointsUnit.textContent = 'ossos';

            walletPointsDisplay.textContent = playerProfile.totalPoints;
            sidebarBonesDisplay.textContent = playerProfile.totalPoints;

            if (document.activeElement !== playerNameInput) {
                playerNameInput.value = playerProfile.playerName || 'Explorador';
            }

            if (shopBalanceDisplay) {
                shopBalanceDisplay.textContent = `${playerProfile.totalPoints} ossos`;
            }

            // Aplica cosmético de moldura nos avatares e brilho nos painéis
            headerAvatarBox.className = 'w-11 h-11 rounded-xl bg-amber-500/15 border border-amber-500/40 flex items-center justify-center text-amber-400 shadow-inner text-2xl transition-all';
            sidebarAvatarBox.className = 'w-12 h-12 rounded-xl bg-amber-500/15 border border-amber-500/40 flex items-center justify-center text-2xl flex-shrink-0 transition-all';

            const cosmeticItem = shopCatalog.cosmetics.find(c => c.id === playerProfile.equippedCosmetic);
            if (cosmeticItem && cosmeticItem.avatarRingClass) {
                headerAvatarBox.classList.add(cosmeticItem.avatarRingClass);
                sidebarAvatarBox.classList.add(cosmeticItem.avatarRingClass);
            }

            [screenStart, screenQuiz, screenResult, profileSidebarCard].forEach(sec => {
                if (!sec) return;
                sec.classList.remove('cosmetic-card-royal', 'cosmetic-card-bio');
                if (cosmeticItem && cosmeticItem.cardGlowClass) {
                    sec.classList.add(cosmeticItem.cardGlowClass);
                }
            });

            // Renderiza foto de perfil (com suporte a animação) no cabeçalho e no painel esquerdo
            const avatarItem = shopCatalog.avatars.find(a => a.id === playerProfile.equippedAvatar);
            if (avatarItem && avatarItem.id !== 'avatar_amonite') {
                const avatarHtml = `<span class="inline-block leading-none ${avatarItem.animClass || ''}">${avatarItem.icon}</span>`;
                headerAvatarBox.innerHTML = avatarHtml;
                sidebarAvatarBox.innerHTML = avatarHtml;
            } else {
                headerAvatarBox.innerHTML = `
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2z"/>
                        <path d="M12 12c0-2.8 2.2-5 5-5s5 2.2 5 5-2.2 5-5 5c-4.4 0-8-3.6-8-8 0-5.5 4.5-10 10-10"/>
                        <path d="M19 2c2.2 2.2 3 5.5 3 10 0 6.1-4.9 11-11 11-5.5 0-9-4.5-9-9"/>
                    </svg>
                `;
                sidebarAvatarBox.innerHTML = '🐚';
            }

            const titleItem = shopCatalog.titles.find(t => t.id === playerProfile.equippedTitle);
            if (titleItem) {
                headerEquippedTitle.textContent = titleItem.badgeText;
                headerEquippedTitle.classList.remove('hidden');
                sidebarEquippedTitle.textContent = titleItem.badgeText;
            }
        }

        /**
         * Abre ou fecha a Aba da Loja
         */
        function openShop() {
            if (!screenShop.classList.contains('hidden')) {
                closeShop();
                return;
            }

            if (!screenStart.classList.contains('hidden')) {
                previousScreenBeforeShop = 'start';
            } else if (!screenResult.classList.contains('hidden')) {
                previousScreenBeforeShop = 'result';
            } else if (!screenQuiz.classList.contains('hidden')) {
                previousScreenBeforeShop = 'quiz';
            }

            screenStart.classList.add('hidden');
            screenQuiz.classList.add('hidden');
            screenResult.classList.add('hidden');
            screenShop.classList.remove('hidden');
            shopToast.classList.add('hidden');

            updateProfileUI();
            renderShopItems();
        }

        function closeShop() {
            screenShop.classList.add('hidden');
            if (previousScreenBeforeShop === 'result') {
                screenResult.classList.remove('hidden');
            } else if (previousScreenBeforeShop === 'quiz') {
                screenQuiz.classList.remove('hidden');
            } else {
                screenStart.classList.remove('hidden');
            }
        }

        function showShopToast(message, isSuccess = true) {
            shopToast.textContent = message;
            shopToast.classList.remove('hidden', 'bg-emerald-950/90', 'border-emerald-500/50', 'text-emerald-300', 'bg-red-950/90', 'border-red-500/50', 'text-red-300');
            if (isSuccess) {
                shopToast.classList.add('bg-emerald-950/90', 'border-emerald-500/50', 'text-emerald-300');
            } else {
                shopToast.classList.add('bg-red-950/90', 'border-red-500/50', 'text-red-300');
            }
        }

        /**
         * Renderiza os itens da aba selecionada na loja
         */
        function renderShopItems() {
            shopTabBtns.forEach(btn => {
                if (btn.dataset.shopTab === activeShopTab) {
                    btn.classList.add('bg-amber-500', 'text-jungle-950');
                    btn.classList.remove('text-stone-300', 'hover:text-parchment');
                } else {
                    btn.classList.remove('bg-amber-500', 'text-jungle-950');
                    btn.classList.add('text-stone-300', 'hover:text-parchment');
                }
            });

            const items = shopCatalog[activeShopTab] || [];
            shopItemsGrid.innerHTML = '';

            items.forEach(item => {
                const isUnlocked = playerProfile.unlockedItems.includes(item.id);
                const isEquipped =
                    (activeShopTab === 'avatars' && playerProfile.equippedAvatar === item.id) ||
                    (activeShopTab === 'cosmetics' && playerProfile.equippedCosmetic === item.id) ||
                    (activeShopTab === 'titles' && playerProfile.equippedTitle === item.id);

                const card = document.createElement('div');
                card.className = `bg-jungle-950/85 border ${isEquipped ? 'border-amber-400 shadow-lg shadow-amber-500/10' : 'border-emerald-800/50'} rounded-2xl p-4 flex flex-col justify-between gap-3 transition`;

                let headerVisual = '';
                if (activeShopTab === 'avatars') {
                    headerVisual = `
                        <div class="flex items-center gap-2.5">
                            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-2xl">
                                <span class="inline-block ${item.animClass || ''}">${item.icon}</span>
                            </div>
                            <span class="px-2 py-0.5 rounded-md bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-[10px] font-bold uppercase tracking-wider">
                                ${item.animLabel}
                            </span>
                        </div>`;
                } else if (activeShopTab === 'cosmetics') {
                    headerVisual = `
                        <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/40 flex items-center justify-center text-2xl ${item.avatarRingClass || ''}">
                            ${item.previewIcon}
                        </div>`;
                } else if (activeShopTab === 'titles') {
                    headerVisual = `<span class="inline-block px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold uppercase tracking-wider">${item.badgeText}</span>`;
                } else {
                    headerVisual = `<div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-lg">📜</div>`;
                }

                let bodyContent = '';
                if (activeShopTab === 'facts') {
                    bodyContent = isUnlocked
                        ? `<p class="text-xs sm:text-sm text-amber-200/95 bg-amber-500/10 border border-amber-500/25 rounded-xl p-3 leading-relaxed">${item.secretText}</p>`
                        : `<p class="text-xs text-stone-400 italic">${item.preview}</p>`;
                } else {
                    bodyContent = `<p class="text-xs text-stone-400 leading-relaxed">${item.desc}</p>`;
                }

                let actionButton = '';
                if (activeShopTab === 'facts') {
                    if (isUnlocked) {
                        actionButton = `<span class="w-full block text-center py-2 px-3 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold">✓ Curiosidade Habilitada</span>`;
                    } else {
                        actionButton = `<button type="button" data-buy-id="${item.id}" class="shop-action-btn w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-jungle-950 font-bold text-xs sm:text-sm transition cursor-pointer">Habilitar por 🦴 ${item.price} ossos</button>`;
                    }
                } else {
                    if (isEquipped) {
                        actionButton = `<span class="w-full block text-center py-2 px-3 rounded-xl bg-amber-500/20 border border-amber-400/40 text-amber-300 text-xs font-bold">★ Equipado no Perfil</span>`;
                    } else if (isUnlocked) {
                        actionButton = `<button type="button" data-equip-id="${item.id}" class="shop-action-btn w-full py-2 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm transition cursor-pointer">Equipar</button>`;
                    } else {
                        actionButton = `<button type="button" data-buy-id="${item.id}" class="shop-action-btn w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-jungle-950 font-bold text-xs sm:text-sm transition cursor-pointer">Comprar por 🦴 ${item.price} ossos</button>`;
                    }
                }

                card.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-2.5">
                            ${headerVisual}
                            ${!isUnlocked ? `<span class="text-xs font-mono font-bold text-amber-400">🦴 ${item.price} ossos</span>` : ''}
                        </div>
                        <h3 class="font-bold text-sm sm:text-base text-parchment mb-1">${item.name}</h3>
                        ${bodyContent}
                    </div>
                    <div class="pt-1">
                        ${actionButton}
                    </div>
                `;

                shopItemsGrid.appendChild(card);
            });

            // Eventos dos botões de compra e equipar
            shopItemsGrid.querySelectorAll('.shop-action-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const buyId = btn.dataset.buyId;
                    const equipId = btn.dataset.equipId;
                    if (buyId) handlePurchaseItem(buyId);
                    if (equipId) handleEquipItem(equipId);
                });
            });
        }

        function handlePurchaseItem(itemId) {
            const items = shopCatalog[activeShopTab] || [];
            const item = items.find(i => i.id === itemId);
            if (!item || playerProfile.unlockedItems.includes(item.id)) return;

            if (playerProfile.totalPoints < item.price) {
                showShopToast(`Ossos insuficientes! Você precisa de ${item.price} ossos para adquirir "${item.name}".`, false);
                return;
            }

            playerProfile.totalPoints -= item.price;
            playerProfile.unlockedItems.push(item.id);

            if (activeShopTab === 'avatars') {
                playerProfile.equippedAvatar = item.id;
            } else if (activeShopTab === 'cosmetics') {
                playerProfile.equippedCosmetic = item.id;
            } else if (activeShopTab === 'titles') {
                playerProfile.equippedTitle = item.id;
            }

            savePlayerProfile();
            updateProfileUI();
            renderShopItems();
            showShopToast(`Você habilitou "${item.name}"!`, true);
        }

        function handleEquipItem(itemId) {
            if (!playerProfile.unlockedItems.includes(itemId)) return;

            if (activeShopTab === 'avatars') {
                playerProfile.equippedAvatar = itemId;
            } else if (activeShopTab === 'cosmetics') {
                playerProfile.equippedCosmetic = itemId;
            } else if (activeShopTab === 'titles') {
                playerProfile.equippedTitle = itemId;
            }

            savePlayerProfile();
            updateProfileUI();
            renderShopItems();
            showShopToast(`Item equipado com sucesso no seu perfil!`, true);
        }

        // Event Listeners
        difficultyCards.forEach(card => {
            card.addEventListener('click', () => selectDifficulty(card.dataset.difficulty));
        });

        btnStart.addEventListener('click', startQuiz);
        answerForm.addEventListener('submit', handleAnswerSubmit);
        btnNext.addEventListener('click', handleNextStep);
        document.getElementById('btn-restart').addEventListener('click', startQuiz);
        document.getElementById('btn-change-level').addEventListener('click', returnToLevelSelect);

        btnToggleShop.addEventListener('click', openShop);
        btnCloseShop.addEventListener('click', closeShop);
        btnResultShop.addEventListener('click', openShop);

        // Eventos do Painel de Perfil no Canto Esquerdo
        playerNameInput.addEventListener('input', () => {
            playerProfile.playerName = playerNameInput.value.trim() || 'Explorador';
            savePlayerProfile();
        });

        btnEditProfileSidebar.addEventListener('click', () => {
            activeShopTab = 'avatars';
            if (screenShop.classList.contains('hidden')) {
                openShop();
            } else {
                renderShopItems();
            }
        });

        shopTabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                activeShopTab = btn.dataset.shopTab;
                shopToast.classList.add('hidden');
                renderShopItems();
            });
        });

        // Inicializa a interface do perfil ao carregar a página
        updateProfileUI();
    </script>
</body>
</html>
