        /**
         * Normaliza textos removendo acentos, espaços extras e deixando em minúsculo
         */
        function normalizeText(text) {
            return text
                .toString()
                .trim()
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        }

        /**
         * Formata o tempo decorrido em mm:ss ou segundos detalhados
         */
        function formatElapsedTime(ms, detailed = false) {
            const totalSeconds = Math.floor(ms / 1000);
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;

            if (detailed) {
                if (minutes > 0) {
                    return `${minutes}m ${seconds}s`;
                }
                const tenths = Math.floor((ms % 1000) / 100);
                return `${seconds}.${tenths}s`;
            }

            return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        }

        /**
         * Inicia o cronômetro em tempo real
         */
        function startTimer() {
            clearInterval(timerInterval);
            startTime = Date.now();
            timerDisplay.textContent = "00:00";
            timerBadge.classList.remove('hidden');
            timerBadge.classList.add('flex');

            timerInterval = setInterval(() => {
                const elapsed = Date.now() - startTime;
                timerDisplay.textContent = formatElapsedTime(elapsed, false);
            }, 250);
        }

        /**
         * Para o cronômetro e retorna o tempo total gasto em milissegundos
         */
        function stopTimer() {
            clearInterval(timerInterval);
            return startTime ? Date.now() - startTime : 0;
        }

