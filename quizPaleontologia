            // Atualiza o emblema decorativo neutro da pergunta atual
            const emblem = expeditionEmblems[currentQuestionIndex % expeditionEmblems.length];
            const paddedNumber = String(questionNumber).padStart(2, '0');
            fieldLogTag.textContent = `Registro de Campo #${paddedNumber}`;
