        /**
         * Renderiza a pergunta atual na tela com animação suave
         */
        function renderQuestion() {
            isAnswered = false;
            questionStartTime = Date.now();
            const currentData = activeQuestions[currentQuestionIndex];
            const questionNumber = currentQuestionIndex + 1;
            const totalQuestions = activeQuestions.length;

            screenQuiz.classList.remove('animate-fade-in');
            void screenQuiz.offsetWidth;
            screenQuiz.classList.add('animate-fade-in');

            questionCounter.textContent = `Pergunta ${questionNumber} de ${totalQuestions}`;
            scoreLive.textContent = `Acertos: ${pontos} • +${quizEarnedPoints} 🦴`;
